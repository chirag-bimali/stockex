    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SE.Application\SE.Application.csproj" />
    <ProjectReference Include="..\SE.Infrastructure\SE.Infrastructure.csproj" />
  </ItemGroup>

